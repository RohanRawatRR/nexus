OPENAI_API_KEY=sk-...
SECRET_KEY=change-me-in-production-minimum-32-chars
ENVIRONMENT=development

# Optional integrations
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
TEAMS_APP_ID=...
TEAMS_APP_PASSWORD=...

# Storage (defaults work for local dev)
